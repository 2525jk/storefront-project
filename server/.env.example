# Stripe test-mode secret key (Dashboard > Developers > API keys, starts with sk_test_)
STRIPE_SECRET_KEY=sk_test_...

# Signing secret printed by `stripe listen` (starts with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_...

# Port this Express server listens on
PORT=3001

# Base URL of the Astro frontend — used for Checkout success/cancel redirects and CORS
CLIENT_URL=http://localhost:4321
