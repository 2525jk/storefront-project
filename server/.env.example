# Stripe secret key (Dashboard > Developers > API keys). Use a sk_test_ key
# for development; switch to sk_live_ only once the Stripe account is
# activated for live payments.
STRIPE_SECRET_KEY=sk_test_...

# Signing secret for the /webhooks/stripe endpoint. In development this is
# printed by `stripe listen`; in production it's generated when you register
# the live webhook endpoint in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# Port this Express server listens on
PORT=3001

# Base URL of the Astro frontend — used for Checkout success/cancel redirects
# and CORS. In production this must be the deployed frontend's real URL
# (e.g. https://2525jk.github.io/storefront-project), not localhost.
CLIENT_URL=http://localhost:4321

# Comma-separated ISO 3166-1 alpha-2 country codes Checkout will collect a
# shipping address for (e.g. US,CA,GB). Defaults to US-only if unset — widen
# this only once you've confirmed the POD provider ships to those countries.
SHIP_TO_COUNTRIES=US

# Set to "true" to have Stripe calculate and collect tax at Checkout. Leave
# unset/false until Stripe Tax is configured for the account (origin
# address + registrations in the Dashboard) — enabling this first makes
# Checkout session creation fail outright.
STRIPE_AUTOMATIC_TAX=false

# Printful API key (Printful dashboard > Stores > select store > API).
# Required for server/pod/printful.js to actually submit fulfillment
# orders; also requires mapping every product/size in catalog/products.json
# to a real Printful sync variant ID in server/pod/printful-catalog-map.json.
PRINTFUL_API_KEY=
