---
import Layout from '../layouts/Layout.astro';
import ProductActions from '../components/ProductActions.tsx';
import products from '../../catalog/products.json';

interface Product {
  id: string;
  name: string;
  description: string;
  price: number;
  currency: string;
  image: string;
  sizes: string[];
}

const catalog = products as Product[];

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base}${p.replace(/^\//, '')}`;
---

<Layout title="Tee Shop — print-on-demand t-shirts">
	<section class="hero">
		<h1 class="hero-title">Tee Shop</h1>
		<p class="hero-subtitle">
			Print-on-demand t-shirts. Every order is printed after you buy it — nothing sits around
			waiting to sell.
		</p>
		<div class="test-mode-banner">
			Stripe test mode — use card <code>4242 4242 4242 4242</code>, any future expiry, any CVC,
			and any ZIP.
		</div>
		<ul class="trust-badges">
			<li>🔒 Secure checkout via Stripe</li>
			<li>🖨️ Printed to order</li>
			<li>↩️ Hassle-free returns on defects</li>
		</ul>
		<svg
			class="hero-ridge"
			viewBox="0 0 1200 120"
			preserveAspectRatio="none"
			aria-hidden="true"
		>
			<path
				d="M0,90 L120,55 L260,85 L400,35 L560,70 L720,25 L880,65 L1040,40 L1200,80 L1200,120 L0,120 Z"
				fill="rgba(255,255,255,0.14)"
			/>
			<path
				d="M0,105 L160,80 L320,100 L480,65 L660,95 L840,60 L1000,90 L1200,100 L1200,120 L0,120 Z"
				fill="rgba(255,255,255,0.22)"
			/>
		</svg>
	</section>

	<div class="toolbar">
		<input
			class="input toolbar-search"
			type="search"
			id="product-search"
			placeholder="Search products…"
			aria-label="Search products"
		/>
		<select class="select toolbar-sort" id="product-sort" aria-label="Sort products">
			<option value="featured">Featured</option>
			<option value="price-asc">Price: low to high</option>
			<option value="price-desc">Price: high to low</option>
			<option value="name-asc">Name: A to Z</option>
		</select>
	</div>

	<main class="product-grid" id="product-grid">
		{
			catalog.map((product, index) => (
				<div
					class="product-card card-surface"
					data-name={product.name.toLowerCase()}
					data-price={product.price}
					data-order={index}
				>
					<a class="product-card-image" href={withBase(`/products/${product.id}`)}>
						<img src={withBase(product.image)} alt={product.name} loading="lazy" />
					</a>
					<h2>
						<a href={withBase(`/products/${product.id}`)}>{product.name}</a>
					</h2>
					<p>{product.description}</p>
					<p class="price">${(product.price / 100).toFixed(2)}</p>
					<ProductActions client:load product={product} />
				</div>
			))
		}
	</main>
	<p class="toolbar-empty" id="toolbar-empty">No products match your search.</p>
</Layout>

<script>
	const searchInput = document.getElementById('product-search') as HTMLInputElement | null;
	const sortSelect = document.getElementById('product-sort') as HTMLSelectElement | null;
	const grid = document.getElementById('product-grid');
	const emptyMessage = document.getElementById('toolbar-empty');

	function applyFilter() {
		if (!grid) return;
		const query = (searchInput?.value ?? '').trim().toLowerCase();
		const cards = Array.from(grid.children) as HTMLElement[];
		let visibleCount = 0;

		for (const card of cards) {
			const name = card.dataset.name ?? '';
			const matches = name.includes(query);
			card.style.display = matches ? '' : 'none';
			if (matches) visibleCount += 1;
		}

		if (emptyMessage) {
			emptyMessage.style.display = visibleCount === 0 ? 'block' : 'none';
		}
	}

	function applySort() {
		if (!grid || !sortSelect) return;
		const cards = Array.from(grid.children) as HTMLElement[];
		const sorted = [...cards].sort((a, b) => {
			switch (sortSelect.value) {
				case 'price-asc':
					return Number(a.dataset.price) - Number(b.dataset.price);
				case 'price-desc':
					return Number(b.dataset.price) - Number(a.dataset.price);
				case 'name-asc':
					return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
				default:
					return Number(a.dataset.order) - Number(b.dataset.order);
			}
		});
		for (const card of sorted) grid.appendChild(card);
	}

	searchInput?.addEventListener('input', applyFilter);
	sortSelect?.addEventListener('change', applySort);
</script>
