---
import Layout from '../layouts/Layout.astro';
import OrderStatus from '../components/OrderStatus.tsx';

const sessionId = Astro.url.searchParams.get('session_id');
const base = import.meta.env.BASE_URL;
---

<Layout title="Order confirmed — Tee Shop">
	<div class="simple-page">
		<h1>Thank you for your order!</h1>
		{
			sessionId ? (
				<>
					<p>
						Checkout session: <code>{sessionId}</code>
					</p>
					<OrderStatus client:load sessionId={sessionId} />
				</>
			) : (
				<p>No checkout session ID was found in the URL.</p>
			)
		}
		<p><a href={base}>Back to shop</a></p>
	</div>
</Layout>

<script>
	// A completed checkout means everything in the cart was just purchased —
	// clear it so a refresh or repeat visit doesn't show stale items.
	import { clearCart } from '../lib/cart';

	if (new URLSearchParams(window.location.search).get('session_id')) {
		clearCart();
	}
</script>
