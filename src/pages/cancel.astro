---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Checkout cancelled — Tee Shop">
	<div class="simple-page">
		<h1>Checkout cancelled</h1>
		<p>No charge was made. Your cart is still saved — head back and try again whenever you're ready.</p>
		<p><a href={base}>Back to shop</a></p>
	</div>
</Layout>
